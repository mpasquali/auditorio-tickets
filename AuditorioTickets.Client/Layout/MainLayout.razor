@inherits LayoutComponentBase

<div class="page d-flex flex-column min-vh-100 bg-light">
    
    <!-- HEADER -->
    <header class="navbar navbar-expand-lg shadow-sm unaj-header">
        <div class="container px-4">
            <!-- Logo / Marca -->
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-white text-decoration-none m-0" href="">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-buildings" viewBox="0 0 16 16">
                  <path d="M14.763.075A.5.5 0 0 1 15 .5v15a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5V14h-1v1.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V10a.5.5 0 0 1 .342-.474L6 7.64V4.5a.5.5 0 0 1 .276-.447l8-4a.5.5 0 0 1 .487.022M6 8.694 1 10.36V15h5zM7 15h2v-1.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 .5.5V15h2V1.309l-7 3.5z"/>
                  <path d="M2 11h1v1H2zm2 0h1v1H4zm-2 2h1v1H2zm2 0h1v1H4zm4-4h1v1H8zm2 0h1v1h-1zm-2 2h1v1H8zm2 0h1v1h-1zm2-2h1v1h-1zm0 2h1v1h-1zM8 7h1v1H8zm2 0h1v1h-1zm2 0h1v1h-1zM8 5h1v1H8zm2 0h1v1h-1zm2 0h1v1h-1zm0-2h1v1h-1z"/>
                </svg>
                <span class="fs-5 tracking-wide">UNAJ <span class="fw-light opacity-75">| Auditorio</span></span>
            </a>

            <!-- Navegación -->
            <div class="d-flex align-items-center gap-4">
                <a href="" class="text-white text-decoration-none fw-medium nav-link-custom">
                    Cartelera
                </a>
                <a href="/admin/login" class="btn btn-outline-light btn-sm fw-semibold px-4 py-2 rounded-pill shadow-sm btn-gestion">
                    Gestión Interna
                </a>
            </div>
        </div>
    </header>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="flex-grow-1 container my-5">
        <article class="bg-white p-4 p-md-5 rounded-4 shadow-sm border-0 w-100">
            @Body
        </article>
    </main>

    <!-- FOOTER -->
    <footer class="footer-custom text-center py-4 mt-auto">
        <div class="container">
            <p class="mb-1 fw-medium">&copy; 2026 - Universidad Nacional Arturo Jauretche</p>
            <small class="opacity-75">Dirección de Transformación Digital</small>
        </div>
    </footer>
</div>

<!-- ESTILOS PERSONALIZADOS -->
<style>
    /* Tipografía más limpia para toda la app */
    .page {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    /* Fondo degradado moderno para el header */
    .unaj-header {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        padding-top: 1.2rem;
        padding-bottom: 1.2rem;
    }

    /* Efecto subrayado animado para "Cartelera" */
    .nav-link-custom {
        position: relative;
        opacity: 0.9;
        transition: opacity 0.3s ease;
    }
    .nav-link-custom:hover {
        opacity: 1;
    }
    .nav-link-custom::after {
        content: '';
        position: absolute;
        width: 0;
        height: 2px;
        bottom: -4px;
        left: 0;
        background-color: white;
        transition: width 0.3s ease;
    }
    .nav-link-custom:hover::after {
        width: 100%;
    }

    /* Animación de elevación para "Gestión Interna" */
    .btn-gestion {
        transition: all 0.3s ease;
        border-width: 2px;
    }
    .btn-gestion:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(255, 255, 255, 0.2) !important;
        background-color: white;
        color: #1e3c72 !important;
    }

    /* Footer sutil */
    .footer-custom {
        background-color: #212529;
        color: #f8f9fa;
    }
</style>